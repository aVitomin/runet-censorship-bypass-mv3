{
  "name": "runet-censorship-bypass",
  "version": "0.0.19",
  "description": "Development tools for Chromium and Firefox MV3 extensions",
  "scripts": {
    "lint:mv3": "eslint ./src/extension-chromium-mv3/**/*.js",
    "lint:firefox": "eslint ./src/extension-firefox-mv3/**/*.js",
    "build:mv3": "node ./node_modules/gulp/bin/gulp.js buildChromiumMv3 && node ./src/extension-chromium-mv3/test/verify-runtime-icons.js && node ./src/extension-chromium-mv3/test/verify-package-integrity.js",
    "build:firefox": "node ./node_modules/gulp/bin/gulp.js buildFirefoxMv3 && node ./src/extension-firefox-mv3/test/verify-package.js",
    "audit:prod": "npm audit --omit=dev",
    "test": "mocha --recursive ./src/**/test/*",
    "test:mv3": "mocha --recursive ./src/extension-chromium-mv3/test/*",
    "test:pac": "mocha ./src/extension-chromium-mv3/test/pac-regression.js",
    "test:firefox": "mocha --recursive ./src/extension-firefox-mv3/test/*.test.js",
    "test:browser:mv3": "node ./src/extension-chromium-mv3/test/chrome-stable-smoke.js",
    "test:browser:firefox-skeleton": "node ./src/extension-firefox-mv3/test/firefox-lifecycle-smoke.js",
    "verify:mv3": "npm run lint:mv3 && npm run test:mv3 && npm run build:mv3",
    "verify:firefox": "npm run lint:firefox && npm run test:firefox && npm run build:firefox",
    "verify": "npm test && npm run lint:mv3 && npm run lint:firefox && npm run build:mv3 && npm run build:firefox"
  },
  "author": "Ilya Ig. Petrov",
  "license": "GPLv3",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "chai": "4.5.0",
    "eslint": "10.8.1",
    "eslint-config-google": "0.14.0",
    "globals": "17.11.0",
    "mocha": "11.8.0",
    "puppeteer-core": "25.8.0"
  },
  "dependencies": {
    "gulp": "5.0.1",
    "plugin-error": "1.0.1",
    "through2": "4.0.2",
    "tldts": "7.4.8"
  },
  "overrides": {
    "mocha": {
      "serialize-javascript": "7.0.5"
    }
  }
}
